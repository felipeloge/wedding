---
import '../styles/global.scss'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Raíssa & Felipe | 28.11.2026',
  description = 'Celebre conosco o nosso casamento em 28 de novembro de 2026.',
} = Astro.props
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#404a32" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Raíssa & Felipe" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://raissaefelipe2026.com.br/" />
    <meta property="og:image" content="https://raissaefelipe2026.com.br/images/whatsapp-preview.jpeg" />
    <meta property="og:image:secure_url" content="https://raissaefelipe2026.com.br/images/whatsapp-preview.jpeg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="Raíssa & Felipe — 28 de novembro de 2026" />
    <title>{title}</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Imperial+Script&family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
  </head>
  <body class="min-h-screen bg-background antialiased">
    <slot />
  </body>
</html>

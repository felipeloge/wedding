---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
---

<Layout title="Obrigado! | Raíssa & Felipe" description="Seu presente foi recebido com muito carinho!">
  <Header />

  <main class="thank-you-page">
    <div class="thank-you-inner">
      <div class="thank-you-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#404a32" stroke-width="1.5">
          <path d="M20 6 9 17l-5-5" />
        </svg>
      </div>

      <p class="thank-you-eyebrow">Pagamento confirmado</p>
      <h1 class="thank-you-title">Muito obrigado! 🌿</h1>
      <p class="thank-you-text">
        Seu presente foi recebido com muito carinho. Mal podemos esperar para compartilhar
        este momento especial com você em <strong>28 de novembro de 2026</strong>.
      </p>

      <div class="thank-you-actions">
        <a href="/presentes" class="btn-primary">Ver mais presentes</a>
        <a href="/" class="btn-outline">Voltar ao início</a>
      </div>
    </div>
  </main>
</Layout>

<style lang="scss" is:global>
  @use '../styles/variables' as v;

  .thank-you-page {
    padding-top: 64px;
    min-height: 100vh;
    background: v.$c-bg;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 1rem;
    padding-right: 1rem;

    @include v.md { padding-top: 80px; }
  }

  .thank-you-inner {
    max-width: 32rem;
    text-align: center;
    padding: 5rem 0;
  }

  .thank-you-icon {
    width: 4rem;
    height: 4rem;
    border-radius: 9999px;
    background: rgba(64, 74, 50, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 2rem;
  }

  .thank-you-eyebrow {
    font-family: v.$f-body;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.35em;
    color: v.$c-text-muted;
    margin-bottom: 1rem;
  }

  .thank-you-title {
    font-family: v.$f-display;
    font-size: 1.875rem;
    color: v.$c-text;
    margin-bottom: 1.25rem;

    @include v.md { font-size: 2.25rem; }
  }

  .thank-you-text {
    font-family: v.$f-body;
    font-size: 0.875rem;
    color: v.$c-text-muted;
    line-height: 1.625;
    margin-bottom: 2.5rem;
    max-width: 24rem;
    margin-left: auto;
    margin-right: auto;
  }

  .thank-you-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    justify-content: center;

    @include v.sm { flex-direction: row; }
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: v.$f-body;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: white;
    background: v.$c-primary;
    padding: 0.875rem 2rem;
    transition: background-color 150ms;

    &:hover { background: v.$c-primary-dark; }
  }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: v.$f-body;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: v.$c-text;
    border: 1px solid v.$c-border;
    padding: 0.875rem 2rem;
    transition: background-color 150ms;

    &:hover { background: v.$c-surface; }
  }
</style>

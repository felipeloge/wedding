---
export const prerender = false

import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import { GiftGrid } from '../components/GiftGrid'
import type { Gift } from '@wedding/supabase'

let gifts: Gift[] = []

if (import.meta.env.SUPABASE_URL && import.meta.env.SUPABASE_ANON_KEY) {
  try {
    const { createClient } = await import('@supabase/supabase-js')
    const supabase = createClient(import.meta.env.SUPABASE_URL, import.meta.env.SUPABASE_ANON_KEY)
    const { data } = await supabase
      .from('gifts')
      .select('*')
      .eq('is_available', true)
      .order('created_at', { ascending: false })
    gifts = data ?? []
  } catch {
    // Supabase not configured yet — show empty state
  }
}
---

<Layout
  title="Lista de Presentes | Raíssa & Felipe"
  description="Selecione um presente especial para Raíssa e Felipe. Pagamento seguro via Stripe."
>
  <Header />

  <main class="gifts-page-main">
    <!-- Page header -->
    <div class="gifts-page-header">
    <p class="gifts-page-header__eyebrow">Comemore conosco</p>
      <h1 class="gifts-page-header__title">Nossa Lista de Presentes</h1>
      <p class="gifts-page-header__subtitle">
        Sua presença é o maior presente. Mas se desejar nos honrar com um gift,
        escolha algo que tornará nossa nova vida ainda mais especial.
      </p>
    </div>

    <!-- Gift grid -->
    <section class="gifts-page-section">
      <div class="gifts-page-section__inner">
        <GiftGrid client:load gifts={gifts} />
      </div>
    </section>
  </main>

  <footer class="simple-footer">
    <a href="/" class="simple-footer__logo">R &amp; F</a>
    <p class="simple-footer__date">28.11.2026</p>
  </footer>
</Layout>

<style lang="scss" is:global>
  @use '../styles/variables' as v;

  .gifts-page-main {
    padding-top: 64px;

    @include v.md { padding-top: 80px; }
  }

  .gifts-page-header {
    background: v.$c-primary-dark;
    color: white;
    padding: 5rem 1rem;
    text-align: center;

    @include v.md { padding: 7rem 1rem; }

    &__eyebrow {
      font-family: v.$f-body;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.35em;
      color: rgba(255, 255, 255, 0.5);
      margin-bottom: 1rem;
    }

    &__title {
      font-family: v.$f-display;
      font-size: 1.875rem;

      @include v.md { font-size: 3rem; }
    }

    &__subtitle {
      font-family: v.$f-body;
      font-size: 0.875rem;
      color: rgba(255, 255, 255, 0.6);
      margin-top: 1rem;
      max-width: 28rem;
      margin-left: auto;
      margin-right: auto;
      line-height: 1.625;
    }
  }

  .gifts-page-section {
    background: v.$c-bg;
    padding: 4rem 1rem;

    @include v.md { padding: 5rem 2rem; }

    &__inner {
      max-width: 72rem;
      margin: 0 auto;
    }
  }

  .simple-footer {
    background: v.$c-primary-dark;
    color: white;
    padding: 2.5rem 1rem;
    text-align: center;

    &__logo {
      font-family: v.$f-display;
      font-size: 1.25rem;
      letter-spacing: 0.1em;
      color: white;
      transition: color 150ms;

      &:hover { color: v.$c-gold; }
    }

    &__date {
      font-family: v.$f-body;
      font-size: 10px;
      color: rgba(255, 255, 255, 0.3);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-top: 0.25rem;
    }
  }
</style>

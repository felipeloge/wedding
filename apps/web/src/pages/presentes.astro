---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { GiftGrid } from '../components/GiftGrid';
import type { Gift } from '@wedding/supabase';

let gifts: Gift[] = [];

if (import.meta.env.SUPABASE_URL && import.meta.env.SUPABASE_ANON_KEY) {
  try {
    const { createClient } = await import('@supabase/supabase-js');
    const supabase = createClient(import.meta.env.SUPABASE_URL, import.meta.env.SUPABASE_ANON_KEY);
    const { data } = await supabase
      .from('gifts')
      .select('*')
      .order('price_cents', { ascending: true });
    gifts = data ?? []
  } catch {
    // Supabase not configured yet — show empty state
  }
}
---

<Layout
  title="Lista de Presentes | Raíssa & Felipe"
  description="Selecione um presente especial para Raíssa e Felipe. Pagamento seguro via Stripe."
>
  <Header />
  <main class="gifts">
    <div class="gifts__header">
      <h1 class="gifts__title">Lista de Presentes</h1>
      <p class="gifts__description">
        Sua presença é o maior presente. Mas se desejar nos honrar com um presente para
        celebrar nosso novo começo, preparamos uma seleção especial de itens e
        experiências.
      </p>
    </div>
    <section class="gifts__content">
      <GiftGrid client:load gifts={gifts} />
    </section>
  </main>
  <footer class="gifts__footer">
    <a href="/" class="gifts__logo">
      <img src="/images/logo-rs-white.png" alt="Raíssa & Felipe" />
    </a>
    <div class="gifts__date">28.11.2026</div>
  </footer>
</Layout>

<style lang="scss" is:global>
  @use '../styles/variables' as v;

  .gifts__header {
    padding: 10.4rem 1.6rem 4rem;
    background: v.$c-primary-dark;
    text-align: center;
    color: white;
  }

  .gifts__title {
    font-family: v.$f-display;
    font-size: 2.4rem;
  }

  .gifts__description {
    max-width: 48rem;
    margin: 1.6rem auto auto;
    font-family: v.$f-body;
    font-size: 1.6rem;
    line-height: 1.25;
    color: white;
  }

  .gifts__content {
    max-width: 80rem;
    margin-right: auto;
    margin-left: auto;
  }

  .gifts__footer {
    background: v.$c-primary-dark;
    color: white;
    padding: 2.5rem 1rem;
    text-align: center;
  }

  .gifts__footer__logo {
    font-family: v.$f-display;
    font-size: 1.25rem;
    letter-spacing: 0.1em;
    color: white;
    transition: color 150ms;
  }

  .gifts__footer__date {
    font-family: v.$f-body;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.3);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: 0.25rem;
  }
</style>
